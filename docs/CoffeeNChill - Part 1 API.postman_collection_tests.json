                  "pm.test(\"Response body is a JSON array\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Each item has fileName (string), sizeInBytes (number), and lastModified (string)\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.forEach(function (item) {",
                  "        pm.expect(item).to.have.property(\"fileName\").that.is.a(\"string\");",
                  "        pm.expect(item).to.have.property(\"sizeInBytes\").that.is.a(\"number\");",
                  "        pm.expect(item).to.have.property(\"lastModified\").that.is.a(\"string\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
