              "listen": "test",
              "script": {
                "exec": [
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has JSON content-type\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response body has fileName\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.fileName).to.be.a(\"string\").and.to.have.length.above(0);",
                  "});",
                  "",
                  "pm.test(\"Response body has sizeBytes\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.sizeBytes).to.be.a(\"number\").and.to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Response body has uploadedUtc\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.uploadedUtc).to.be.a(\"string\").and.to.have.length.above(0);",
                  "});",
                  "",
                  "pm.test(\"fileName matches uploaded file\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.fileName).to.match(/\\.txt$/);",
                  "});",
                  ""
